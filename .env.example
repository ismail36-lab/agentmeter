# ─────────────────────────────────────────────────────────────────────────────
# Meterix — Environment Variables Reference
#
# Copy this file to .env (or .env.local for local development) and fill in
# every value marked REQUIRED.  Values marked OPTIONAL can be left blank
# to disable the related feature.
#
#   cp .env.example .env
#
# NEVER commit a file containing real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase — REQUIRED ───────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://<ref>.supabase.co)
# For local self-hosting with Docker, point this at your Supabase-compatible
# endpoint or the local postgres service (see SELF_HOSTING.md).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in the browser (used by client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — SERVER SIDE ONLY. Bypasses RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Full Postgres connection string (used by migration tooling / direct DB access)
# Example (Supabase Cloud):  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Example (Docker local):    postgresql://meterix:meterix_password@postgres:5432/meterix
DATABASE_URL=postgresql://user:password@host:5432/database


# ── Application — REQUIRED ────────────────────────────────────────────────────
# Public-facing base URL of this deployment (no trailing slash)
# Local:       http://localhost:3000
# Production:  https://meterix.dev  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Local PostgreSQL — only needed when using docker-compose with local Postgres
# These variables are consumed by the postgres & migrate services.
POSTGRES_DB=meterix
POSTGRES_USER=meterix
POSTGRES_PASSWORD=change_me_in_production


# ── Resend (transactional email) — OPTIONAL ───────────────────────────────────
# Required for budget alerts, anomaly notifications, and welcome emails.
# Sign up at https://resend.com — free tier is sufficient for low volume.
RESEND_API_KEY=re_your_resend_api_key
# Sender address registered in Resend (must be a verified domain)
RESEND_FROM_EMAIL=Meterix <support@yourdomain.com>


# ── Upstash Redis (rate limiting) — OPTIONAL ──────────────────────────────────
# Required for per-key rate limiting on ingestion endpoints.
# Leave blank to disable rate limiting (not recommended for production).
# Sign up at https://console.upstash.com — free tier works fine.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token


# ── LemonSqueezy (billing) — OPTIONAL ────────────────────────────────────────
# Required only if you enable the billing / plan upgrade features.
# Sign up at https://lemonsqueezy.com.
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_PRO_VARIANT_ID=your_pro_variant_id
# Webhook secret from LemonSqueezy dashboard → Webhooks → Signing Secret
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret


# ── Cron authentication — RECOMMENDED ────────────────────────────────────────
# Secret passed as Bearer token by Vercel (or your cron scheduler) when
# triggering /api/v1/cron/* endpoints.  Choose a strong random string.
CRON_SECRET=your_cron_secret_here
